{
  "schemaVersion": 1,
  "id": "animegg-english-dub",
  "familyID": "animegg-english-dub",
  "name": "AnimeGG English Dub",
  "version": "1.0.0",
  "minimumAppVersion": "0.1.0",
  "contentType": "video",
  "language": "en",
  "contentRating": "unknown",
  "releaseTrack": "beta",
  "status": "active",
  "attribution": {
    "author": "godinezjoel",
    "website": "https://www.animegg.org"
  },
  "authorization": {
    "basis": "personal",
    "note": "Experimental declarative connector. Use only content you are entitled to access; no third-party content or distribution rights are supplied."
  },
  "allowedHosts": [
    "www.animegg.org",
    "vidcache.net",
    "*.vidcache.net"
  ],
  "capabilities": [
    "discovery",
    "search",
    "details",
    "episodes",
    "streams"
  ],
  "limits": {
    "timeoutMilliseconds": 20000,
    "maxConcurrentRequests": 2,
    "maxResponseBytes": 8388608
  },
  "operations": {
    "discovery": {
      "sections": [
        {
          "id": "latest",
          "title": "Recently Added",
          "semantic": "recent",
          "request": {
            "method": "GET",
            "urlTemplate": "https://www.animegg.org/releases",
            "headers": {
              "Accept": "text/html",
              "Referer": "https://www.animegg.org/"
            }
          },
          "response": {
            "format": "html"
          },
          "items": {
            "collection": "ul.popanime.cats li.fea.release",
            "fields": {
              "sourceID": {
                "selector": "a.releaseLink",
                "part": "attr",
                "attr": "href",
                "transforms": [
                  {
                    "op": "removePrefix",
                    "value": "/series/"
                  }
                ]
              },
              "title": {
                "selector": "a.releaseLink",
                "part": "text",
                "transforms": [
                  {
                    "op": "trim"
                  }
                ]
              },
              "posterURL": {
                "selector": "div.releaseImg img",
                "part": "attr",
                "attr": "src"
              }
            }
          }
        },
        {
          "id": "popular",
          "title": "Popular",
          "semantic": "popular",
          "request": {
            "method": "GET",
            "urlTemplate": "https://www.animegg.org/",
            "headers": {
              "Accept": "text/html",
              "Referer": "https://www.animegg.org/"
            }
          },
          "response": {
            "format": "html"
          },
          "items": {
            "collection": "ul.popanime li",
            "fields": {
              "sourceID": {
                "selector": "div.rightpop > a",
                "part": "attr",
                "attr": "href",
                "transforms": [
                  {
                    "op": "removePrefix",
                    "value": "/series/"
                  }
                ]
              },
              "title": {
                "selector": "div.rightpop > a",
                "part": "text",
                "transforms": [
                  {
                    "op": "trim"
                  }
                ]
              },
              "posterURL": {
                "selector": "div.img img",
                "part": "attr",
                "attr": "src"
              }
            }
          }
        }
      ]
    },
    "search": {
      "request": {
        "method": "GET",
        "urlTemplate": "https://www.animegg.org/search?q={query}",
        "headers": {
          "Accept": "text/html",
          "Referer": "https://www.animegg.org/"
        }
      },
      "response": {
        "format": "html"
      },
      "items": {
        "collection": "a.mse",
        "fields": {
          "sourceID": {
            "selector": "a.mse",
            "part": "attr",
            "attr": "href",
            "transforms": [
              {
                "op": "removePrefix",
                "value": "/series/"
              }
            ]
          },
          "title": {
            "selector": "h2",
            "part": "text",
            "transforms": [
              {
                "op": "trim"
              }
            ]
          },
          "posterURL": {
            "selector": "img",
            "part": "attr",
            "attr": "src"
          }
        }
      }
    },
    "details": {
      "request": {
        "method": "GET",
        "urlTemplate": "https://www.animegg.org/series/{titleID}",
        "headers": {
          "Accept": "text/html",
          "Referer": "https://www.animegg.org/"
        }
      },
      "response": {
        "format": "html"
      },
      "extract": {
        "title": {
          "selector": "div.fattynav h1",
          "part": "text",
          "transforms": [
            {
              "op": "trim"
            }
          ]
        },
        "synopsis": {
          "selector": "p.ptext",
          "part": "text",
          "transforms": [
            {
              "op": "trim"
            }
          ]
        },
        "posterURL": {
          "selector": "div.fattynav img.media-object",
          "part": "attr",
          "attr": "src"
        },
        "genres": {
          "collection": "ul.tagscat li a"
        }
      }
    },
    "episodes": {
      "request": {
        "method": "GET",
        "urlTemplate": "https://www.animegg.org/series/{titleID}",
        "headers": {
          "Accept": "text/html",
          "Referer": "https://www.animegg.org/"
        }
      },
      "response": {
        "format": "html"
      },
      "extract": {
        "collection": "ul.newmanga > li > div:has(span.btn-dubbed)",
        "fields": {
          "episodeID": {
            "selector": "a.anm_det_pop",
            "part": "attr",
            "attr": "href",
            "transforms": [
              {
                "op": "removePrefix",
                "value": "/"
              }
            ]
          },
          "title": {
            "selector": "strong",
            "part": "text",
            "transforms": [
              {
                "op": "trim"
              }
            ]
          },
          "episodeNumber": {
            "selector": "a.anm_det_pop",
            "part": "attr",
            "attr": "href",
            "transforms": [
              {
                "op": "firstInteger"
              }
            ]
          },
          "availableVariants": {
            "collection": "span.btn-dubbed",
            "transforms": [
              {
                "op": "lowercased"
              },
              {
                "op": "replaceFirst",
                "find": "dubbed",
                "with": "dub"
              }
            ]
          }
        }
      }
    },
    "streams": {
      "variants": [
        "dub"
      ],
      "playbackHeaders": {
        "Referer": "https://www.animegg.org/"
      },
      "steps": [
        {
          "request": {
            "method": "GET",
            "urlTemplate": "https://www.animegg.org/{episodeID}",
            "headers": {
              "Accept": "text/html",
              "Referer": "https://www.animegg.org/"
            }
          },
          "response": {
            "format": "html"
          },
          "extract": {
            "context": {
              "embedID": {
                "selector": "ul#videos a[data-version^=\"{variant}\"]",
                "part": "attr",
                "attr": "data-id"
              }
            }
          }
        },
        {
          "request": {
            "method": "GET",
            "urlTemplate": "https://www.animegg.org/embed/{embedID}",
            "headers": {
              "Accept": "text/html",
              "Referer": "https://www.animegg.org/"
            }
          },
          "response": {
            "format": "html"
          },
          "extract": {
            "collection": "html",
            "fields": {
              "url": {
                "selector": "meta[property=\"og:video\"]",
                "part": "attr",
                "attr": "content",
                "transforms": [
                  {
                    "op": "absolutize"
                  }
                ]
              }
            }
          }
        }
      ]
    }
  },
  "releaseNotes": "English Dub from AnimeGG. Lists only episodes AnimeGG marks as dubbed and plays the English audio track. Use AniWorld Deutsch for German Dub and AniWorld OmU for subtitles."
}
